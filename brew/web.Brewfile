# Serves: the-house, mkw-data-api, hiddenvector.studio
# Node itself is owned by fnm, never by Homebrew.
brew "fnm"
brew "supabase/tap/supabase"
brew "railway"
brew "jq"

# Container runtime for `supabase start` (Postgres/GoTrue/Storage run as
# containers locally). OrbStack and Colima serve the same Docker API if you
# prefer one — put that in ~/.config/hv/local.Brewfile, not here.
cask "docker-desktop"
