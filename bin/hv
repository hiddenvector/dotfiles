#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real location even when symlinked to ~/.local/bin/hv.
_hv_self="${BASH_SOURCE[0]}"
while [ -L "$_hv_self" ]; do
  _hv_dir="$(cd "$(dirname "$_hv_self")" && pwd)"
  _hv_self="$(readlink "$_hv_self")"
  case "$_hv_self" in /*) ;; *) _hv_self="$_hv_dir/$_hv_self" ;; esac
done
HV_ROOT="$(cd "$(dirname "$_hv_self")/.." && pwd)"
export HV_ROOT

HV_STEPS_DIR="${HV_STEPS_DIR:-$HV_ROOT/setup/steps}"

for _lib in log link machine config prompt docs; do
  # shellcheck disable=SC1090
  . "$HV_ROOT/setup/lib/$_lib.sh"
done

# Populates HV_MODULES (and friends) for every step. Step subshells inherit
# this from the parent environment, so one call here covers them all --
# without it, hv::modules/hv::module_enabled see an unset HV_MODULES and,
# under this script's `set -u`, blow up the first time any step calls them.
hv::config_load

HV_DRY_RUN="${HV_DRY_RUN:-0}"
HV_YES="${HV_YES:-0}"
export HV_DRY_RUN HV_YES

hv::usage() {
  cat >&2 <<'USAGE'
usage: hv <command> [options]

commands:
  setup           converge this machine to the declared state
  check           report drift; mutates nothing; exits 1 if drifted
  update          git pull, then converge
  identity        re-run the identity step
  machine         re-run machine name and module selection
  overlay init    create and wire up a personal overlay repo
  cheatsheet      print usage docs for installed modules

options:
  --only <name>   run only the named step
  --dry-run       print what would change, change nothing
  --yes           accept defaults without prompting
USAGE
}

hv::steps() {
  local f overlay
  for f in "$HV_STEPS_DIR"/*.sh; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
  overlay="$(hv::config_get HV_OVERLAY 2>/dev/null || true)"
  if [ -n "$overlay" ] && [ "$overlay" != "none" ] && [ -d "$overlay/steps" ]; then
    for f in "$overlay"/steps/*.sh; do
      [ -f "$f" ] && printf '%s\n' "$f"
    done
  fi
}

# Echo the file implementing the named step, or nothing.
# Return codes: 0 = found (path printed), 1 = no step has this name,
# 2 = a candidate step file failed to parse (message already on stderr).
# Distinguishing 1 from 2 matters because this runs inside a caller's
# `file="$(hv::step_file ...)"` command substitution: that forks a
# subshell, so calling hv::die (which calls `exit`) in here would only
# exit the subshell, not the whole script -- the caller would still see a
# nonzero status and, without this distinction, report "unknown step" on
# top of the parse error already printed. So this function reports parse
# failures itself, via hv::err, and returns 2 for the caller to check.
#
# The `.` builtin returns nonzero when the sourced file fails to parse, but
# that alone does not abort the enclosing script -- a bare
# `. "$f"; printf ...` would let the trailing printf succeed and mask the
# failure. The inner script below captures `.`'s own exit status and exits
# with it explicitly, after printing whatever name (if any) did get set, so
# the parse failure survives as the exit status of the whole `bash -c`.
hv::step_file() {
  local want="$1" f name err_file err rc
  for f in $(hv::steps); do
    err_file="$(mktemp)"
    if name="$(bash -c '
        . "$1" 2>"$2"
        src_rc=$?
        printf "%s" "${HV_STEP_NAME:-}"
        exit "$src_rc"
      ' _ "$f" "$err_file")"; then
      rc=0
    else
      rc=$?
    fi
    err="$(tr '\n' ' ' < "$err_file")"
    rm -f "$err_file"
    if [ "$rc" -ne 0 ]; then
      hv::err "failed to parse step file: $f${err:+ -- ${err% }}"
      return 2
    fi
    [ "$name" = "$want" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# Run one step file. mode is "check", "run", or "converge".
# --dry-run is enforced by each step's own use of hv::run, not here: that is
# what lets `hv setup --dry-run` preview the actual commands a step would
# execute instead of just naming which steps are drifted.
hv::step_invoke() {
  local file="$1" mode="$2"
  (
    # shellcheck disable=SC1090
    . "$file"
    case "$mode" in
      check) hv_step_check ;;
      run)   hv_step_run ;;
      converge)
        if hv_step_check >/dev/null 2>&1; then
          exit 0
        fi
        hv_step_run
        ;;
    esac
  )
}

hv::cmd_setup() {
  local only="${1:-}" file rc
  if [ -n "$only" ]; then
    if file="$(hv::step_file "$only")"; then
      rc=0
    else
      rc=$?
    fi
    # rc 2 means hv::step_file already reported a parse failure on stderr;
    # anything else nonzero means no step by this name exists.
    [ "$rc" -eq 2 ] && return 1
    [ "$rc" -eq 0 ] || hv::die "unknown step: $only"
    hv::step_invoke "$file" run
    return $?
  fi
  # Contract: any unguarded failing command inside hv_step_run stops the
  # whole run, not just that step. Steps that cannot do their job (Touch ID
  # blocked by MDM, a non-admin account, ...) must warn and return 0 --
  # reserve a nonzero return from hv_step_run for genuinely unrecoverable
  # conditions. When one does return nonzero here, we stop rather than
  # silently skip it: continuing past a real failure would let `hv setup`
  # report success on a machine that is only half-converged.
  for file in $(hv::steps); do
    if ! hv::step_invoke "$file" converge; then
      hv::err "step failed: $(basename "$file")"
      hv::log "Remaining steps were not run. Fix the cause and re-run: hv setup"
      return 1
    fi
  done
}

hv::cmd_check() {
  local file drifted=0 name
  for file in $(hv::steps); do
    if ! hv::step_invoke "$file" check; then
      name="$(basename "$file")"
      hv::warn "drifted: ${name%.sh}"
      drifted=1
    fi
  done
  [ "$drifted" = "0" ] && hv::ok "all checks passed"
  return "$drifted"
}

# Not a converge step -- cheatsheet only ever reads docs/usage/*.md and
# prints or regenerates, it never mutates machine state. Keeping it out of
# hv::cmd_setup means it can never be picked up by `hv::steps`/`hv setup`.
hv::cmd_cheatsheet() {
  hv::config_load
  local valid
  case "${1:-}" in
    --regenerate) hv::docs_generate; hv::ok "docs/USAGE.md regenerated" ;;
    --all) hv::docs_cheatsheet all ;;
    "") hv::docs_cheatsheet ;;
    *)
      if ! hv::docs_cheatsheet "$1"; then
        valid="$(hv::docs_order | tr '\n' ' ')"
        hv::die "unknown module: $1 (expected one of: ${valid% })"
      fi
      ;;
  esac
}

main() {
  local cmd="${1:-}" only=""
  [ $# -gt 0 ] && shift

  # "overlay" takes an optional "init" subcommand; the two are equivalent.
  # Anything else after "overlay" that isn't a recognized flag is rejected
  # here -- otherwise the option loop below silently discards it and
  # `hv overlay bogus` would quietly behave like plain `hv overlay`.
  if [ "$cmd" = "overlay" ]; then
    case "${1:-}" in
      init) shift ;;
      ""|--only|--dry-run|--yes) : ;;
      *) hv::die "unknown overlay subcommand: $1 (expected: init)" ;;
    esac
  fi

  # Anything that isn't a recognized flag is a positional argument for the
  # command itself (e.g. the module name or --all/--regenerate for
  # `cheatsheet`) -- collect it instead of discarding it, so `hv cheatsheet
  # swift` actually reaches hv::cmd_cheatsheet.
  local -a rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --only) only="${2:-}"; shift 2 ;;
      --dry-run) HV_DRY_RUN=1; export HV_DRY_RUN; shift ;;
      --yes) HV_YES=1; export HV_YES; shift ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- "${rest[@]+"${rest[@]}"}"

  case "$cmd" in
    setup)     hv::cmd_setup "$only" ;;
    check)     hv::cmd_check ;;
    update)    hv::run git -C "$HV_ROOT" pull --ff-only && hv::cmd_setup "" ;;
    identity)  hv::cmd_setup identity ;;
    machine)   hv::cmd_setup machine ;;
    overlay)
      # overlay already targets a single, fixed step -- --only makes no
      # sense combined with it. Reject rather than silently ignoring it.
      [ -n "$only" ] && hv::die "--only is not valid with 'overlay' (it already targets the overlay step)"
      hv::cmd_setup overlay ;;
    cheatsheet) hv::cmd_cheatsheet "$@" ;;
    ""|help|-h|--help) hv::usage; return 1 ;;
    *) hv::err "unknown command: $cmd"; hv::usage; return 1 ;;
  esac
}

main "$@"
